impl string {
    public extern func length(self): number;
    public extern func split(self, sep: string): List<string>;
    public extern func trim(self): string;
    public extern func trim_start(self): string;
    public extern func trim_end(self): string;
    public extern func to_upper(self): string;
    public extern func to_lower(self): string;
    public extern func starts_with(self, prefix: string): boolean;
    public extern func ends_with(self, suffix: string): boolean;
    public extern func contains(self, substr: string): boolean;
    public extern func replace(self, from: string, to: string): string;
    public extern func substring(self, start: number, end_exclusive: number): string;
    public extern func index_of(self, substr: string): number?;
    public extern func chars(self): List<string>;
    public extern func parse_number(self): number?;

    public func repeat(self, n: number): string {
        let result = "";
        let i = 0;
        while i < n {
            result = result + self;
            i += 1;
        }
        return result;
    }
}
