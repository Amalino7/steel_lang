impl number {
    public func abs(self): number {
        if self < 0 {
            return -self;
        }
        else{
            return self;
        }
    }
    public extern func floor(self): number;
    public extern func ceil(self): number;
    public extern func round(self): number;
    public extern func trunc(self): number;
    public extern func sqrt(self): number;
    public extern func pow(self, exp: number): number;
    public extern func log(self): number;
    public extern func log2(self): number;
    public extern func log10(self): number;
    public extern func sin(self): number;
    public extern func cos(self): number;
    public extern func tan(self): number;
    public extern func min(self, other: number): number;
    public extern func max(self, other: number): number;
}
